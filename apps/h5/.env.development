NODE_ENV = 'development'
# base api
# SERVER_PORT 来自宿主仓库根目录 .env.development，独立使用时默认为 80。
VITE_APP_BASE_URL = 'http://127.0.0.1:${SERVER_PORT}/'
VITE_APP_BASE_NAME = 'FaberAdmin'
VITE_APP_FILE_PREFIX = 'dev'
VITE_APP_TINYMCE_API_KEY = 'xxx'
VITE_APP_FA_FROM = 'web'
VITE_APP_FA_VERSION_CODE = '1000000'
VITE_APP_FA_VERSION_NAME = '1.0.0'
